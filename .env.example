# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=

# --- Job APIs (planned) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Recruitee careers-site token, sent as the X-Careers-Sites-Token header.
# Optional while Recruitee still answers unauthenticated calls, but from
# 2027-02-10 their docs say calls without the header return 401 Unauthorized.
# Leaving it empty is valid until then.
RECRUITEE_CAREERS_SITES_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# --- Observability (BrainTrust, optional) ---
# Leave BRAINTRUST_API_KEY empty to disable tracing entirely: every call to the
# LLM client is then a local no-op and nothing leaves the machine.
# What may be sent is decided by an explicit allowlist in
# atlas.observability.ALLOWED_PAYLOAD_KEYS: only stage/job identity, scores,
# decisions, veto and rejection rule ids, model names, prompt versions, latency
# and token counts. Resume text, profile.json contents, name, email, phone,
# prompt text and every link except the job url are dropped before sending.
BRAINTRUST_API_KEY=
# Project name for traces created by atlas.observability; the dashboard URL
# printed on publish follows this name.
BRAINTRUST_PROJECT=My Project
# Project id that receives atlas.observability rows (traces and eval scores).
# Changing this redirects every write to a different Braintrust project.
BRAINTRUST_PROJECT_ID=d7011a46-5b44-404c-a2d8-f0024bb40920
# Org that owns the project above. This is the login org, and it is not the
# project name; getting it wrong silently disables tracing.
BRAINTRUST_ORG=atlasops
# Set to 1 to force-disable telemetry even when a key is present.
ATLAS_OFFLINE=

# --- Optional overrides (not secrets) ---
# Path to the SQLite database. Defaults to atlas.db in the repo root; tests set
# this to an isolated/temporary file.
ATLAS_DB=
